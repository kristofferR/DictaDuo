<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>DictaDuo</string>
	<key>CFBundleIdentifier</key>
	<string>com.kristofferr.dictaduo</string>
	<key>CFBundleName</key>
	<string>DictaDuo</string>
	<key>CFBundleDisplayName</key>
	<string>DictaDuo</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>DictaDuo</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>DictaDuo records your microphone only while you dictate and sends audio to your configured DictaDuo server for transcription and shared history.</string>
	<key>NSInputMonitoringUsageDescription</key>
	<string>DictaDuo listens for your chosen hold-to-dictate key. It does not store your keystrokes.</string>
	<!-- HTTP is validated in ServerEndpoint and limited to loopback/Tailscale IPs. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- macOS 14+ requires explicit IP exceptions matching ServerEndpoint. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.0/8</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>::1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>fd7a:115c:a1e0::/48</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DictaDuo connects to your DictaDuo server to process dictation and display shared history.</string>
	<key>DictaDuoDevelopmentBuild</key>
	<false/>
</dict>
</plist>
