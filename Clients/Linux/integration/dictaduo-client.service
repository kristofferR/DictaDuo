[Unit]
Description=DictaDuo desktop dictation client
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/opt/dictaduo-linux/current/dictaduo daemon
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
